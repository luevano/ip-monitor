[Unit]
Description=IP Monitor (DNS updater and stale IPv6 address cleanup)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ip-monitor
Group=ip-monitor
ExecStart=/usr/bin/ip-monitor
TimeoutStartSec=300

# The config holds API keys and is kept encrypted (see ip-monitor-config);
# systemd decrypts it and hands the service a private copy.
LoadCredentialEncrypted=config.sh:/etc/ip-monitor/config.sh.cred
StateDirectory=ip-monitor
StateDirectoryMode=0700

# The one privilege: removing stale IPv6 addresses from the interface.
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN

NoNewPrivileges=yes
UMask=0077
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

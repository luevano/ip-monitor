#!/usr/bin/bash
#
# ip-monitor-config: manage the ip-monitor client's config, which is kept
# encrypted (systemd-creds, with this machine's key) because it holds the
# API token, the Vultr API key and the Discord webhook.
#
# Usage: ip-monitor-config edit|import FILE|show

set -euo pipefail

CRED="/etc/ip-monitor/config.sh.cred"
SAMPLE="/usr/share/doc/ip-monitor/config.sh.sample"
NAME="config.sh"

die ()
{
	echo "$*" >&2
	exit 1
}

# $1 = plain config file
encrypt ()
{
	local new
	bash -n "$1" || die "The config has a syntax error, nothing was saved."
	install -d -m 755 "${CRED%/*}"
	new="$(mktemp "$CRED.XXXXXX")"
	if ! systemd-creds encrypt --name="$NAME" "$1" - > "$new"; then
		rm -f "$new"
		die "Encrypting failed, nothing was saved."
	fi
	chmod 600 "$new"
	mv -f "$new" "$CRED"
	echo "Saved $CRED."
}

decrypt ()
{
	systemd-creds decrypt --name="$NAME" "$CRED" -
}

pick_editor ()
{
	local editor
	for editor in "${SUDO_EDITOR:-}" "${VISUAL:-}" "${EDITOR:-}" vi nano; do
		if [ -n "$editor" ] && command -v "${editor%% *}" > /dev/null; then
			echo "$editor"
			return 0
		fi
	done
	die "No editor found, set EDITOR."
}

case "${1:-}" in
	edit|import|show) ;;
	*) die "Usage: ${0##*/} edit|import FILE|show" ;;
esac
[ "$(id -u)" -eq 0 ] || die "Run it as root."

case "$1" in
	edit)
		editor="$(pick_editor)"
		# /run is in memory: the plain text never reaches the disk
		tmp="$(mktemp -p /run ip-monitor-config.XXXXXX)"
		trap 'rm -f "$tmp"' EXIT
		if [ -f "$CRED" ]; then
			decrypt > "$tmp"
		else
			cat "$SAMPLE" > "$tmp"
		fi
		$editor "$tmp"
		encrypt "$tmp"
		;;
	import)
		[ -r "${2:-}" ] || die "Usage: ${0##*/} import FILE"
		encrypt "$2"
		echo "$2 still exists in plain text: delete it once everything works."
		;;
	show)
		[ -f "$CRED" ] || die "There's no config yet, create it with: ${0##*/} edit"
		decrypt
		;;
esac
